    "submission_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Submission Url"
    },
    "template": {
      "$ref": "#/$defs/TemplateInfo"
    },
    "timezone": {
      "default": "AoE",
      "title": "Timezone",
      "type": "string"
    },
    "year": {
      "title": "Year",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "name",
    "year",
    "status",
    "source_urls",
    "template"
  ],
  "title": "VenueRecord",
  "type": "object"
}
